# JWT
SECURITY_JWT_ISSUER=cloud-native-mall
SECURITY_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
SECURITY_JWT_BASE64=false
SECURITY_JWT_EXPIRE_SECONDS=7200

# Gateway route targets
USER_SERVICE_URI=http://localhost:8081
PRODUCT_SERVICE_URI=http://localhost:8082
ORDER_SERVICE_URI=http://localhost:8083
PAYMENT_SERVICE_URI=http://localhost:8084

# Service discovery & config center
EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka
CONFIG_SERVER_URL=http://localhost:8888
SEATA_ENABLED=false
SEATA_SERVER_ADDR=127.0.0.1:8091

# Tracing (Jaeger OTLP)
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Databases
SPRING_DATASOURCE_USERNAME=change_me_db_username
SPRING_DATASOURCE_PASSWORD=change_me_db_password

# Bootstrap login passwords (required)
MALL_BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password
MALL_BOOTSTRAP_ALICE_PASSWORD=change_me_alice_password
MALL_BOOTSTRAP_BOB_PASSWORD=change_me_bob_password

# Redis
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Elasticsearch
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# Gateway rate limit
GATEWAY_RATE_LIMIT_REPLENISH=20
GATEWAY_RATE_LIMIT_BURST=40
